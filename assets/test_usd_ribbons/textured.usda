def BasisCurves "RibbonUnconnected" (prepend apiSchemas = ["MaterialBindingAPI"]) {
 uniform token type = "linear"
 int[] curveVertexCounts = [2]
 point3f[] points = [(0,3,0),(6,3,0)]
 normal3f[] normals = [(0,0,1)] (interpolation = "constant")
 float[] widths = [0.65] (interpolation = "constant")
 bool doubleSided = true
 rel material:binding = </Unconnected>

}

def BasisCurves "RibbonMissingST" (prepend apiSchemas = ["MaterialBindingAPI"]) {
 uniform token type = "linear"
 int[] curveVertexCounts = [2]
 point3f[] points = [(0,1.5,0),(6,1.5,0)]
 normal3f[] normals = [(0,0,1)] (interpolation = "constant")
 float[] widths = [0.65] (interpolation = "constant")
 bool doubleSided = true
 rel material:binding = </MissingST>

}

def BasisCurves "RibbonReaderFallback" (prepend apiSchemas = ["MaterialBindingAPI"]) {
 uniform token type = "linear"
 int[] curveVertexCounts = [2]
 point3f[] points = [(0,0,0),(6,0,0)]
 normal3f[] normals = [(0,0,1)] (interpolation = "constant")
 float[] widths = [0.65] (interpolation = "constant")
 bool doubleSided = true
 rel material:binding = </ReaderFallback>

}

def BasisCurves "RibbonAuthoredST" (prepend apiSchemas = ["MaterialBindingAPI"]) {
 uniform token type = "linear"
 int[] curveVertexCounts = [2]
 point3f[] points = [(0,-1.5,0),(6,-1.5,0)]
 normal3f[] normals = [(0,0,1)] (interpolation = "constant")
 float[] widths = [0.65] (interpolation = "constant")
 bool doubleSided = true
 rel material:binding = </AuthoredST>
 texCoord2f[] primvars:st = [(0.1,0.25),(0.9,0.75)] (interpolation = "vertex")
}

def Mesh "Control" (prepend apiSchemas = ["MaterialBindingAPI"]) {
 uniform token subdivisionScheme = "none"
 int[] faceVertexCounts = [4]
 int[] faceVertexIndices = [0,1,2,3]
 point3f[] points = [(0,-3.325,0),(6,-3.325,0),(6,-2.675,0),(0,-2.675,0)]
 texCoord2f[] primvars:st = [(0,0),(1,0),(1,1),(0,1)] (interpolation = "vertex")
 rel material:binding = </MeshControl>
 bool doubleSided = true
}
